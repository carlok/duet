import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fin.VecNotation

/-! # Cand23: a 4-element countermodel

Generated by `soup.lean_cert` from tables that `soup.check_offline.check_finite` accepted.
Source: `work/check/profile_candidates.json (smallest non-degenerate model, candidate 23)`.

Laws of the theory (· = `f`, ∘ = `g`):
- `x · (x · y) = x ∘ x`
- `x · x = y ∘ (x ∘ y)`
- `x · y = (y · x) ∘ y`

Claims refuted:
- `x · y = x`
- `x · y = y`
- `x ∘ y = x`
- `x ∘ y = y`
- `x · y = x ∘ y`
- `x · y = y ∘ x`
-/

namespace Duet.Cand23

/-- The theory Cand23: the conjunction of its laws. -/
def Theory {α : Type} (f g : α → α → α) : Prop :=
  (∀ x y : α, (f x (f x y)) = (g x x))
  ∧ (∀ x y : α, (f x x) = (g y (g x y)))
  ∧ (∀ x y : α, (f x y) = (g (f y x) y))

/-- The operation `·` of the countermodel. -/
def F : Fin 4 → Fin 4 → Fin 4 := ![![0, 0, 0, 0], ![0, 0, 0, 2], ![0, 0, 0, 0], ![0, 2, 0, 0]]

/-- The operation `∘` of the countermodel. -/
def G : Fin 4 → Fin 4 → Fin 4 := ![![0, 0, 0, 0], ![0, 0, 0, 0], ![0, 2, 0, 2], ![0, 0, 0, 0]]

/-- The tables satisfy every law of the theory. -/
theorem model : Theory F G := by
  unfold Theory
  decide

/-- The theory does not imply `x · y = x`. -/
theorem not_0 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = x) := by
  intro h
  have := h (Fin 4) F G model
  revert this
  decide

/-- The theory does not imply `x · y = y`. -/
theorem not_1 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = y) := by
  intro h
  have := h (Fin 4) F G model
  revert this
  decide

/-- The theory does not imply `x ∘ y = x`. -/
theorem not_2 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (g x y) = x) := by
  intro h
  have := h (Fin 4) F G model
  revert this
  decide

/-- The theory does not imply `x ∘ y = y`. -/
theorem not_3 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (g x y) = y) := by
  intro h
  have := h (Fin 4) F G model
  revert this
  decide

/-- The theory does not imply `x · y = x ∘ y`. -/
theorem not_4 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = (g x y)) := by
  intro h
  have := h (Fin 4) F G model
  revert this
  decide

/-- The theory does not imply `x · y = y ∘ x`. -/
theorem not_5 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = (g y x)) := by
  intro h
  have := h (Fin 4) F G model
  revert this
  decide

end Duet.Cand23

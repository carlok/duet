/-- The theory does not imply `x · y = y ∘ x`. -/
theorem not_5 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = (g y x)) := by
  intro h
  have := h (Fin 3) F G model

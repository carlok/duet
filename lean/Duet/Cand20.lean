namespace Duet.Cand20

/-- The theory Cand20: the conjunction of its laws. -/
def Theory {α : Type} (f g : α → α → α) : Prop :=
  (∀ x y : α, (f x (g y x)) = x)
  ∧ (∀ x y : α, (g x (f (g x y) y)) = x)
  ∧ (∀ x y : α, (g x (g (f x y) x)) = x)
  ∧ (∀ x y : α, (f x (g (g y y) (f y x))) = x)

/-- The operation `·` of the countermodel. -/
def F : Fin 3 → Fin 3 → Fin 3 := ![![0, 0, 0], ![1, 1, 2], ![2, 1, 2]]

/-- The operation `∘` of the countermodel. -/
def G : Fin 3 → Fin 3 → Fin 3 := ![![0, 0, 0], ![1, 1, 0], ![2, 0, 2]]

/-- The tables satisfy every law of the theory. -/
theorem model : Theory F G := by
  unfold Theory
  decide

/-- The theory does not imply `x · y = x`. -/
theorem not_0 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = x) := by
  intro h
  have := h (Fin 3) F G model
  revert this
  decide

/-- The theory does not imply `x · y = y`. -/
theorem not_1 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = y) := by
  intro h
  have := h (Fin 3) F G model
  revert this
  decide

/-- The theory does not imply `x ∘ y = x`. -/
theorem not_2 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (g x y) = x) := by
  intro h
  have := h (Fin 3) F G model
  revert this
  decide

/-- The theory does not imply `x ∘ y = y`. -/
theorem not_3 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (g x y) = y) := by
  intro h
  have := h (Fin 3) F G model
  revert this
  decide

/-- The theory does not imply `x · y = x ∘ y`. -/
theorem not_4 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x y : α, (f x y) = (g x y)) := by
  intro h
  have := h (Fin 3) F G model
  revert this

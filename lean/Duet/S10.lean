import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fin.VecNotation

/-! # S10: a 10-element countermodel

Generated by `soup.lean_cert` from tables that `soup.check_offline.check_finite` accepted.
Source: `work/check/s10_vampire_casc_sat.out`.

Laws of the theory (· = `f`, ∘ = `g`):
- `x · x = x ∘ x`
- `x · (y ∘ (y ∘ (x ∘ y))) = x`
- `x ∘ (y · (y · (x · y))) = x`
- `(((x ∘ y) ∘ x) ∘ x) · y = y`
- `(((x · y) · x) · x) ∘ y = y`

Claims refuted:
- `x · x = x`
- `x ∘ x = x`
- `x · (x · x) = x`
-/

namespace Duet.S10

/-- The theory S10: the conjunction of its laws. -/
def Theory {α : Type} (f g : α → α → α) : Prop :=
  (∀ x : α, (f x x) = (g x x))
  ∧ (∀ x y : α, (f x (g y (g y (g x y)))) = x)
  ∧ (∀ x y : α, (g x (f y (f y (f x y)))) = x)
  ∧ (∀ x y : α, (f (g (g (g x y) x) x) y) = y)
  ∧ (∀ x y : α, (g (f (f (f x y) x) x) y) = y)

/-- The operation `·` of the countermodel. -/
def F : Fin 10 → Fin 10 → Fin 10 := ![![1, 2, 3, 5, 5, 3, 3, 5, 0, 0], ![6, 1, 5, 1, 5, 5, 6, 1, 1, 1], ![0, 1, 2, 3, 4, 5, 6, 2, 8, 2], ![4, 1, 4, 3, 4, 5, 3, 1, 3, 3], ![6, 6, 4, 4, 4, 5, 6, 4, 8, 4], ![6, 5, 5, 5, 5, 5, 6, 6, 5, 5], ![4, 6, 6, 3, 6, 6, 6, 6, 6, 6], ![0, 1, 2, 3, 4, 5, 6, 7, 7, 9], ![6, 1, 8, 3, 8, 5, 3, 7, 8, 9], ![6, 5, 2, 3, 5, 5, 3, 9, 9, 9]]

/-- The operation `∘` of the countermodel. -/
def G : Fin 10 → Fin 10 → Fin 10 := ![![1, 2, 9, 0, 9, 0, 9, 8, 9, 8], ![9, 1, 9, 3, 9, 1, 1, 7, 8, 9], ![7, 2, 2, 2, 2, 2, 2, 7, 2, 9], ![7, 3, 9, 3, 3, 3, 6, 8, 8, 9], ![0, 0, 2, 3, 4, 4, 4, 7, 4, 9], ![7, 1, 2, 3, 4, 5, 5, 8, 8, 9], ![0, 1, 2, 6, 4, 5, 6, 7, 8, 9], ![2, 7, 7, 7, 7, 7, 7, 7, 8, 7], ![2, 8, 2, 8, 4, 8, 2, 8, 8, 8], ![7, 7, 9, 9, 7, 9, 7, 7, 8, 9]]

/-- The tables satisfy every law of the theory. -/
theorem model : Theory F G := by
  unfold Theory
  decide

/-- The theory does not imply `x · x = x`. -/
theorem not_0 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x : α, (f x x) = x) := by
  intro h
  have := h (Fin 10) F G model
  revert this
  decide

/-- The theory does not imply `x ∘ x = x`. -/
theorem not_1 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x : α, (g x x) = x) := by
  intro h
  have := h (Fin 10) F G model
  revert this
  decide

/-- The theory does not imply `x · (x · x) = x`. -/
theorem not_2 : ¬ ∀ (α : Type) (f g : α → α → α), Theory f g → (∀ x : α, (f x (f x x)) = x) := by
  intro h
  have := h (Fin 10) F G model
  revert this
  decide

end Duet.S10
